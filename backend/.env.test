# .env
ENVIR=prod


DATABASE__TYPE=postgresql
DATABASE__HOST=127.0.0.1
DATABASE__PORT=5432
DATABASE__USERNAME=postgres
DATABASE__PASSWORD=123456
DATABASE__DATABASE=smilex_cloud
DATABASE__ECHO=True

JWT__SECRET_KEY=smilexcloud123456
JWT__ALGORITHM=HS256
JWT__ACCESS_LIFETIME=7200
JWT__REFRESH_LIFETIME=604800

# 服务对外访问
SERVICE__BASE_URL=http://127.0.0.1:8000
SERVICE__INTERNAL_TOKEN=test_internal_token_please_change

# gRPC 配置
GRPC__ENABLED=true
GRPC__MAP_SERVICE_ADDR=127.0.0.1:50051
GRPC__CONFIG_SERVICE_ADDR=127.0.0.1:50052
GRPC__TIMEOUT_SECONDS=10