# ------------------------------
# Redis 配置（示例）
# 会话/验证码/限流/IP黑名单/在线用户/机器人状态等均依赖 Redis，为必配项。
# 嵌套配置用双下划线：REDIS__HOST 对应 settings.REDIS.HOST。
# 以下为默认值示例，按需取消注释并修改；
# 环境差异（如密码）建议写到对应的 .env.dev / .env.test / .env.prod（后者覆盖前者）。
# ------------------------------
# REDIS__HOST=localhost
# REDIS__PORT=6379
# REDIS__DB=0
# REDIS__PASSWORD=
# REDIS__DECODE_RESPONSES=true
# REDIS__MAX_CONNECTIONS=20
# REDIS__SOCKET_TIMEOUT=5
# REDIS__SOCKET_CONNECT_TIMEOUT=3
# REDIS__SOCKET_KEEPALIVE=true
