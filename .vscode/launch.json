{
  "version": "0.2.0",
  "configurations": [
    // 后端FastAPI启动配置
    {
      "name": "后端 - FastAPI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/main.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env.dev",
      "args": [
        "--reload"
      ],
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe"
    },
    
    // 前端Vue启动配置
    {
      "name": "前端 - Vue",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:9527",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true,
      "preLaunchTask": "npm: dev"
    },
    
    // 前端TypeScript调试
    {
      "name": "前端 - TS Debugger",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "tsx",
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/frontend/node_modules/**"],
      "program": "${file}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}/frontend"
    }
  ]
}